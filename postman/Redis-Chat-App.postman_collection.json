{
  "info": {
    "name": "Redis Chat App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Create chat room",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomName\": \"general\"\n}"
        }
      }
    },
    {
      "name": "1b. Create duplicate room (expect 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomName\": \"general\"\n}"
        }
      }
    },
    {
      "name": "2. Join chat room",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general/join",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general",
            "join"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participant\": \"guest_user\"\n}"
        }
      }
    },
    {
      "name": "2b. Join second user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general/join",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general",
            "join"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participant\": \"another_user\"\n}"
        }
      }
    },
    {
      "name": "3. Send message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participant\": \"guest_user\",\n  \"message\": \"Hello, everyone!\"\n}"
        }
      }
    },
    {
      "name": "3b. Send second message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participant\": \"another_user\",\n  \"message\": \"Hi, guest_user!\"\n}"
        }
      }
    },
    {
      "name": "3c. Send to non-existent room (expect 404)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/does-not-exist/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "does-not-exist",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participant\": \"guest_user\",\n  \"message\": \"Hi\"\n}"
        }
      }
    },
    {
      "name": "4. Get last 10 messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general/messages?limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general",
            "messages"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "4b. Get last 1 message",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general/messages?limit=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general",
            "messages"
          ],
          "query": [
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "5. Real-time stream (SSE) - keep open, send a message from another request",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general/stream?participant=guest_user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general",
            "stream"
          ],
          "query": [
            {
              "key": "participant",
              "value": "guest_user"
            }
          ]
        }
      }
    },
    {
      "name": "6. Delete chat room",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general"
          ]
        }
      }
    },
    {
      "name": "6b. Delete again (expect 404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/general",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chatapp",
            "chatrooms",
            "general"
          ]
        }
      }
    }
  ]
}